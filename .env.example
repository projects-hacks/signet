# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. Never commit it, and never paste a real value into this
# file. Placeholders here are deliberate: an empty value trips the gitleaks
# entropy rule on the key name alone.
#
# Nothing below is needed to run the test suite or the CLI. Fixtures are on by
# default and every adapter serves recorded responses until you turn them off.

# ---------------------------------------------------------------- runtime
# 1 serves recorded responses and makes no network calls. 0 hits live APIs.
SIGNET_FIXTURES=1

# The demo issuer and its lookalike. Both must be domains you own.
# Never register a permutation of a real company's domain, not even to demo one.
SIGNET_DEMO_DOMAIN=replace-me
SIGNET_DEMO_LOOKALIKE=replace-me
SIGNET_DEMO_BRAND=replace-me

# Which sites may call the verifier from a browser, comma separated. Leave empty
# when one process serves both the page and the API. Static hosting runs no
# server side code, so a page deployed there needs the verifier's origin named.
# Set to 0 to create the enrolment envelope as a draft instead of mailing it.
# Useful while rehearsing. An envelope costs the same either way.
SIGNET_SEND_ENVELOPES=1

SIGNET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Xano
# System of record. Base URL is the API group URL from your workspace.
XANO_BASE_URL=replace-me
XANO_API_KEY=replace-me

# ---------------------------------------------------------------- Nutrient
# Extraction, AI redaction, Viewer tokens. Live or test key both work.
# https://api.nutrient.io  ·  campaign account gives 5,000 free credits.
NUTRIENT_API_KEY=replace-me

# ---------------------------------------------------------------- Foxit
# One credential pair and one gateway for every Foxit API. eSign, PDF Services,
# Document Generation and Embed all authenticate with these two headers, and the
# storage region chosen at activation does not change the endpoint.
# Portal: app.developer-api.foxit.com, default application.
FOXIT_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=replace-me
FOXIT_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------- Doctavian
# Portal > Developers. Two tabs, two values.
#   Authorization  -> personal access token, sent as the Bearer token
#   API Keys       -> the key for the version you are calling, sent as x-api-key
# If the API Keys version dropdown also lists a separate Signatures key, set
# DOCTAVIAN_SIGNATURES_KEY. Leave it as-is and the one key covers both.
# The Client Header tab is only for async generation, which we do not use.
#
# The hackathon account lives on demo.api.doctavian.com, which appears in no
# published spec. A key issued for one environment is refused by another with
# ApiKeyInvalid, so the host is configuration rather than a constant.
#
# Templates are class=path pairs. The file is uploaded on every render because a
# generation consumes the stored template and the next one fails with
# FILE_MISSING_FROM_STORAGE.
DOCTAVIAN_TEMPLATES=invoice=assets/northpost-invoice.docx#Invoice,authorisation=assets/signet-authorisation.docx#Enrolment
# The bearer is a session, not a value you paste. Run
#   uv run python scripts/doctavian_login.py
# once; it writes .signet/doctavian-session.json and renews itself from there.
DOCTAVIAN_BASE_URL=https://api.doctavian.com/v1
DOCTAVIAN_API_KEY=replace-me
DOCTAVIAN_SIGNATURES_KEY=replace-me

# ---------------------------------------------------------------- name.com
# Use the API token, not your account password. Two-step verification must be
# off; their API rejects accounts that have it enabled.
# Production writes real DNS. Sandbox (https://api.dev.name.com) needs the
# username suffixed with -test and domains pre-registered there.
NAMECOM_USERNAME=replace-me
NAMECOM_TOKEN=replace-me
NAMECOM_BASE_URL=https://api.name.com

# ---------------------------------------------------------------- SerpApi
# 250 searches a month, 50 an hour. Leave fixtures on while developing or the
# month is gone by Thursday.
SERPAPI_API_KEY=replace-me

# ---------------------------------------------------------------- LLM
# Drives the enrolment agent, and writes narrative text. Never the verdict, and
# never a gate: preconditions are enforced in code because a model that was told
# to hurry will skip a check it was asked to perform (ADR 0007).
# OpenAI-compatible, so any provider works by changing the base URL.
# NVIDIA keys come from build.nvidia.com and start nvapi-.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-me
# Measured against our own tool schemas, not chosen from a leaderboard. See
# ADR 0007 for the run: same tool sequence as models 25 times slower.
LLM_MODEL=openai/gpt-oss-120b

# Nutrient DWS campaign portal (event access page, not the API key)
NUTRIENT_CAMPAIGN_USER=replace-me
NUTRIENT_CAMPAIGN_PASSWORD=replace-me
