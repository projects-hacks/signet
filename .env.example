# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. Never commit it, and never paste a real value into this
# file. Placeholders here are deliberate: an empty value trips the gitleaks
# entropy rule on the key name alone.
#
# Nothing below is needed to run the test suite or the CLI. Fixtures are on by
# default and every adapter serves recorded responses until you turn them off.

# ---------------------------------------------------------------- runtime
# 1 serves recorded responses and makes no network calls. 0 hits live APIs.
SIGNET_FIXTURES=1

# The demo issuer and its lookalike. Both must be domains you own.
# Never register a permutation of a real company's domain, not even to demo one.
SIGNET_DEMO_DOMAIN=replace-me
SIGNET_DEMO_LOOKALIKE=replace-me
SIGNET_DEMO_BRAND=replace-me

# ---------------------------------------------------------------- Xano
# System of record. Base URL is the API group URL from your workspace.
XANO_BASE_URL=replace-me
XANO_API_KEY=replace-me

# ---------------------------------------------------------------- Nutrient
# Extraction, AI redaction, Viewer tokens. Live or test key both work.
# https://api.nutrient.io  ·  campaign account gives 5,000 free credits.
NUTRIENT_API_KEY=replace-me

# ---------------------------------------------------------------- Foxit
# Two separate credential sets, deliberately. PDF Services is the MCP tool
# catalog; eSign is the human gate and is provisioned separately.
FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com
FOXIT_CLOUD_API_CLIENT_ID=replace-me
FOXIT_CLOUD_API_CLIENT_SECRET=replace-me

FOXIT_ESIGN_BASE_URL=https://api.foxitesign.foxit.com
FOXIT_ESIGN_API_KEY=replace-me

# ---------------------------------------------------------------- Doctavian
# x-api-key is scoped per API area, so the Documents key will not open
# Signatures. Grab both from the portal API Keys page.
# The bearer is a standard OAuth 2.0 token from Google or Microsoft, not a
# Doctavian credential. Tokens are rejected within ~2 minutes of expiry, so a
# pasted one is fine for development and must be refreshed before a demo.
DOCTAVIAN_BASE_URL=https://api.doctavian.com/v1
DOCTAVIAN_DOCUMENTS_KEY=replace-me
DOCTAVIAN_SIGNATURES_KEY=replace-me
DOCTAVIAN_TOKEN=replace-me

# ---------------------------------------------------------------- name.com
# Use the API token, not your account password. Two-step verification must be
# off; their API rejects accounts that have it enabled.
# Production writes real DNS. Sandbox (https://api.dev.name.com) needs the
# username suffixed with -test and domains pre-registered there.
NAMECOM_USERNAME=replace-me
NAMECOM_TOKEN=replace-me
NAMECOM_BASE_URL=https://api.name.com

# ---------------------------------------------------------------- SerpApi
# 250 searches a month, 50 an hour. Leave fixtures on while developing or the
# month is gone by Thursday.
SERPAPI_API_KEY=replace-me

# ---------------------------------------------------------------- LLM
# Narrative text and lookalike candidate generation only. Never the verdict.
# OpenAI-compatible, so any provider works by changing the base URL.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=meta/llama-3.3-70b-instruct
